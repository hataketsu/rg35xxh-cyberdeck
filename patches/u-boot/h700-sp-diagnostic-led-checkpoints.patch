--- a/board/sunxi/board.c
+++ b/board/sunxi/board.c
@@ -191,6 +191,11 @@
 {
 	__maybe_unused int id_pfr1, ret;
 
+	/* SP diagnostic: both LEDs mark entry into U-Boot proper. */
+	gpio_direction_output(SUNXI_GPI(12), 1);
+	gpio_direction_output(SUNXI_GPI(11), 1);
+	mdelay(1000);
+
 	gd->bd->bi_boot_params = (PHYS_SDRAM_0 + 0x100);
 
 #if !defined(CONFIG_ARM64) && !defined(CONFIG_MACH_SUNIV)
@@ -555,6 +560,8 @@
 	/* No status_led_init(): its BSS lives in uninitialized DRAM. */
 	if (IS_ENABLED(CONFIG_SPL_DRIVERS_MISC))
 		gpio_direction_output(SUNXI_GPI(11), 1);
+	/* Clear a green LED left on by a warm reset: SPL starts red only. */
+	gpio_direction_output(SUNXI_GPI(12), 0);
 #endif
 
 #ifdef CONFIG_SY8106A_POWER
@@ -636,6 +643,11 @@
 	printf(" %d MiB\n", (int)(gd->ram_size >> 20));
 	if (!gd->ram_size)
 		hang();
+
+	/* SP diagnostic: green means DRAM init returned a nonzero size. */
+	gpio_direction_output(SUNXI_GPI(12), 1);
+	gpio_direction_output(SUNXI_GPI(11), 0);
+	mdelay(1000);
 
 	sunxi_spl_store_dram_size(gd->ram_size);
 
