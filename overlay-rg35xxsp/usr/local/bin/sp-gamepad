#!/usr/bin/env python3
"""Creueta H700 → cursor. Només captura el gamepad intern identificat."""
import select
import signal
import time


class Directions:
    def __init__(self):
        self.keys = set()
        self.hat = [0, 0]

    def move(self):
        x = int('right' in self.keys) - int('left' in self.keys)
        y = int('down' in self.keys) - int('up' in self.keys)
        return (x or self.hat[0])*4, (y or self.hat[1])*4


def main():
    from evdev import InputDevice, UInput, ecodes as e, list_devices
    device = None
    for path in list_devices():
        candidate = InputDevice(path)
        if (candidate.name == 'H700 Gamepad' and candidate.info.vendor == 0x484b
                and candidate.info.product == 0x14df):
            device = candidate
            break
        candidate.close()
    if device is None:
        raise RuntimeError('No es troba H700 Gamepad 484b:14df; no es captura cap teclat')
    directions = Directions()
    dpad = {e.BTN_DPAD_LEFT: 'left', e.BTN_DPAD_RIGHT: 'right',
            e.BTN_DPAD_UP: 'up', e.BTN_DPAD_DOWN: 'down'}
    # La posició física A/B s'ha de confirmar amb evtest a la consola.
    keys = {e.BTN_EAST: e.BTN_LEFT, e.BTN_SOUTH: e.BTN_RIGHT,
            e.BTN_NORTH: e.KEY_ENTER, e.BTN_WEST: e.KEY_BACKSPACE,
            e.BTN_START: e.KEY_LEFTMETA, e.BTN_SELECT: e.KEY_ESC,
            e.BTN_TR2: e.KEY_TAB, e.BTN_TL2: e.KEY_SPACE}
    caps = {e.EV_KEY: list(set(keys.values())), e.EV_REL: [e.REL_X, e.REL_Y, e.REL_WHEEL]}
    running = True

    def stop(*_):
        nonlocal running
        running = False

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    pressed = set()
    with UInput(caps, name='cyberdeck-sp-pointer') as ui:
        device.grab()
        try:
            deadline = time.monotonic()
            while running:
                if select.select([device.fd], [], [], max(0, deadline-time.monotonic()))[0]:
                    for event in device.read():
                        if event.type == e.EV_SYN and event.code == e.SYN_DROPPED:
                            # Reiniciar el servei evita cursor/botons enganxats.
                            raise RuntimeError('SYN_DROPPED: reinici segur del mapper')
                        if event.type == e.EV_KEY and event.code in dpad:
                            if event.value: directions.keys.add(dpad[event.code])
                            else: directions.keys.discard(dpad[event.code])
                        elif event.type == e.EV_ABS and event.code in (e.ABS_HAT0X, e.ABS_HAT0Y):
                            directions.hat[int(event.code == e.ABS_HAT0Y)] = max(-1, min(1, event.value))
                        elif event.type == e.EV_KEY and event.code in keys and event.value in (0, 1):
                            code = keys[event.code]
                            if event.value: pressed.add(code)
                            else: pressed.discard(code)
                            ui.write(e.EV_KEY, code, event.value); ui.syn()
                        elif event.type == e.EV_KEY and event.value == 1 and event.code in (e.BTN_TL, e.BTN_TR):
                            ui.write(e.EV_REL, e.REL_WHEEL, 1 if event.code == e.BTN_TR else -1); ui.syn()
                if time.monotonic() >= deadline:
                    dx, dy = directions.move()
                    if dx or dy:
                        ui.write(e.EV_REL, e.REL_X, dx); ui.write(e.EV_REL, e.REL_Y, dy); ui.syn()
                    deadline = time.monotonic() + 0.02
        finally:
            for code in pressed: ui.write(e.EV_KEY, code, 0)
            ui.syn()
            device.ungrab()
            device.close()


if __name__ == '__main__':
    main()
